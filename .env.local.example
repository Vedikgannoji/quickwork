# ─── Supabase ─────────────────────────────────────────────────────────────────
# Browser-visible (safe — enforces RLS via anon key)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Server-only (NEVER use VITE_ prefix — must not appear in the client bundle)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# ─── How to get these values ──────────────────────────────────────────────────
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Go to Settings → API
# 4. Copy:
#      "Project URL"          → VITE_SUPABASE_URL + SUPABASE_URL
#      "anon public" key      → VITE_SUPABASE_ANON_KEY
#      "service_role secret"  → SUPABASE_SERVICE_ROLE_KEY  (keep this secret!)
#
# ─── Vercel deployment ────────────────────────────────────────────────────────
# Add all 4 values in:
#   Vercel Dashboard → Project → Settings → Environment Variables
# For SUPABASE_SERVICE_ROLE_KEY, set Environment = "Production, Preview" (NOT Browser)
